{
    "name": "@teecustody/web",
    "version": "0.0.0",
    "description": "Browser adapters for tee-custody: WebCrypto, fetch transport and WebAuthn-PRF share vault",
    "type": "module",
    "exports": {
        ".": "./dist/index.js"
    },
    "types": "./dist/index.d.ts",
    "bin": {
        "teecustody-profile": "./dist/profile/bin.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "vitest run",
        "build:cli": "esbuild src/profile/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/profile/bin.js --alias:@teecustody/core=../teecustody-core/src/index.ts \"--banner:js=#!/usr/bin/env node\"",
        "coverage": "vitest run --coverage",
        "lint": "eslint . && prettier --check . && node ../../tools/scan-bundle.mjs --entry src/index.ts --alias @teecustody/core=../teecustody-core/src/index.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.cli.json",
        "test:browser": "playwright test --pass-with-no-tests"
    },
    "dependencies": {
        "@hpke/core": "1.9.0",
        "@teecustody/core": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "fake-indexeddb": "6.2.5"
    }
}
